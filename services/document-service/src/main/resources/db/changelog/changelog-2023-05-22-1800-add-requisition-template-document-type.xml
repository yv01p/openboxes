<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">

    <property name="now" value="now()"/>
    <changeSet author="awalkowiak" id="2205202318000-0">
        <!-- preCondition relocated during Phase 1 Task 6. Original Grails-side predicate
             was `WHERE id = "REQUISITION_TEMPLATE"` (PK-based; the PK and code happened to
             coincide for this row). Switched to document_code (functional identity) for
             consistency with the other two relocated INSERT changesets. Both produce
             MARK_RAN on dev and production. -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM document_type WHERE document_code='REQUISITION_TEMPLATE'
            </sqlCheck>
        </preConditions>
        <insert tableName="document_type">
            <column name="id" value="REQUISITION_TEMPLATE"/>
            <column name="version" valueNumeric="0"/>
            <column name="name" value="Requisition Template"/>
            <column name="description"/>
            <column name="document_code" value="REQUISITION_TEMPLATE"/>
            <column name="date_created" valueDate="${now}"/>
            <column name="last_updated" valueDate="${now}"/>
            <column name="sort_order" valueNumeric="0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
