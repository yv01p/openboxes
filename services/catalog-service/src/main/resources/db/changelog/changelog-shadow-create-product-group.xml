<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
                   logicalFilePath="services/catalog-service/db/changelog/changelog-shadow-create-product-group.xml">
    <changeSet id="phase5-shadow-create-product-group" author="openboxes-catalog">
        <preConditions onFail="MARK_RAN" onFailMessage="product_group table not found — Grails Liquibase must run first">
            <tableExists tableName="product_group"/>
        </preConditions>
        <comment>
            Shadow for product_group table. Grails Liquibase owns table creation.
            catalog-service uses spring.jpa.hibernate.ddl-auto=validate to prove entity-mapping correctness.
        </comment>
        <!-- No body: table already exists per the precondition. -->
    </changeSet>
</databaseChangeLog>
