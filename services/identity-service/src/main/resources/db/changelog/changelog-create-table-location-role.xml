<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
                   logicalFilePath="services/identity-service/db/changelog/changelog-create-table-location-role.xml">
    <changeSet id="phase2-shadow-create-location-role" author="openboxes-identity">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="location_role"/></not>
        </preConditions>
        <createTable tableName="location_role">
            <column name="user_id" type="CHAR(38)"/>
            <column name="location_id" type="CHAR(38)"/>
            <column name="role_id" type="CHAR(38)"/>
            <column name="version" type="INT"/>
            <column name="id" type="CHAR(38)"/>
            <column name="location_roles_idx" type="INT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="location_role" baseColumnNames="user_id"
                                 constraintName="fk_location_role_user"
                                 referencedTableName="user" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="location_role" baseColumnNames="location_id"
                                 constraintName="fk_location_role_location"
                                 referencedTableName="location" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="location_role" baseColumnNames="role_id"
                                 constraintName="fk_location_role_role"
                                 referencedTableName="role" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
