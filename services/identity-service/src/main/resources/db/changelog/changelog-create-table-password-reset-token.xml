<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
                   logicalFilePath="services/identity-service/db/changelog/changelog-create-table-password-reset-token.xml"
                   objectQuotingStrategy="QUOTE_ALL_OBJECTS">
    <changeSet id="phase2-create-password-reset-token" author="openboxes-identity">
        <createTable tableName="password_reset_token">
            <column name="token" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="CHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="password_reset_token" baseColumnNames="user_id"
                                 constraintName="fk_password_reset_token_user"
                                 referencedTableName="user" referencedColumnNames="id"/>
        <createIndex indexName="idx_password_reset_token_expires_at" tableName="password_reset_token">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
